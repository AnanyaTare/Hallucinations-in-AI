# ── LLM API Keys ─────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# ── App Settings ─────────────────────────────────────────────
APP_NAME="Hallucinations-in-AI API"
APP_VERSION="1.0.0"
DEBUG=false
DEFAULT_MODEL=groq/llama-3.1-8b-instant

# ── Database ─────────────────────────────────────────────────
DATABASE_URL=sqlite:///./hallucinations.db

# ── Evaluation ───────────────────────────────────────────────
HALLUCINATION_THRESHOLD=0.5
MAX_TOKENS=512
TEMPERATURE=0.0

# ── RAG ──────────────────────────────────────────────────────
CHROMA_PERSIST_DIR=data/processed/chroma_db
TOP_K_RETRIEVAL=5

# ── Self-Consistency ─────────────────────────────────────────
SELF_CONSISTENCY_N=5
